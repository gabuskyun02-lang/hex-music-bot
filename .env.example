# Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=

# Optional: set during development for instant guild-scoped command updates.
# Unset = global registration (Discord may take up to an hour to propagate).
GUILD_ID=

# Your Discord user ID — required for /debug access
BOT_OWNER_ID=

# Logging: debug | info | warn | error
LOG_LEVEL=info

# SQLite database path (created if missing)
DB_PATH=./data/hex-music-bot.db

# Lavalink nodes (comma-separated, format: name:password@host:port)
# Public nodes with LavaSrc support: see https://lavalink.dev
LAVALINK_NODES=main:youshallnotpass@localhost:2333

# Examples:
# LAVALINK_NODES=node1:pass1@node1.example.com:443,node2:pass2@node2.example.com:443
# Use wss:// prefix for secure connections:
# LAVALINK_NODES=backup:mypass@wss://free.lavalink.dev:443

# Pause playback when voice channel empties (default true)
AUTO_PAUSE=true

# Idle auto-disconnect in seconds after queue drains (default 300; 0 = disabled)
LEAVE_TIMEOUT_SECONDS=300

# Prometheus metrics + status API listen address (empty = disabled)
METRICS_ADDR=:9090
